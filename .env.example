# ============================================================
# MessageFlow environment variables (copy to .env and edit)
# ============================================================

# --- Database ---
# PostgreSQL connection string (psycopg2 driver).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://messageflow:messageflow@localhost:5432/messageflow

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit a real secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phone validation ---
# Default region used when a number has no international prefix.
DEFAULT_REGION=IN

# --- Uploads ---
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_IMPORT=10/minute

# --- Devices / pairing (Phase 2) ---
# Absolute base URL the Android phone uses to reach this backend; it is
# embedded in the pairing QR code. Leave empty to derive it from the request
# (correct when the browser hits the backend directly, or behind a reverse
# proxy that sets X-Forwarded-Host).
# Set it when the phone must use a different address than the request shows,
# e.g. PUBLIC_SERVER_URL=http://192.168.1.50:8000 on a LAN, or
# PUBLIC_SERVER_URL=https://sms.example.com in production.
PUBLIC_SERVER_URL=
# How long a QR pairing token stays valid.
PAIRING_TOKEN_TTL_MINUTES=5
# How long a device JWT (WebSocket auth) stays valid.
DEVICE_TOKEN_EXPIRE_DAYS=30
# Mark a device OFFLINE when no heartbeat/WS traffic arrives within N seconds.
DEVICE_OFFLINE_TIMEOUT_SECONDS=60
# Server-side WebSocket ping interval.
DEVICE_WS_PING_SECONDS=25

# --- Sending (Phase 2) ---
# Recipients per dispatch batch sent to the Android device.
SEND_BATCH_SIZE=5
# Maximum messages dispatched per minute per device (pacing).
SEND_RATE_PER_MINUTE=20
# Set false to disable the background dispatch/offline loops (tests do this).
SEND_DISPATCH_ENABLED=true
# Auto-pause a campaign when its device goes OFFLINE mid-send.
PAUSE_CAMPAIGN_ON_DEVICE_OFFLINE=true
# STOP/UNSUBSCRIBE keyword list (inbound SMS handling).
STOP_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,END,QUIT,STOPALL
# Auto-reply after a STOP keyword. Default OFF - never auto-reply unless
# you explicitly enable and are compliant with your carrier's rules.
STOP_AUTO_REPLY_ENABLED=false
STOP_AUTO_REPLY_TEXT=You have been unsubscribed from future messages.

# --- App ---
APP_NAME=MessageFlow
APP_ENV=development
DEBUG=false
