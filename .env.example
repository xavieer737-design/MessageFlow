# ============================================================
# MessageFlow environment variables (copy to .env and edit)
# ============================================================

# --- Database ---
# PostgreSQL connection string (psycopg2 driver).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://messageflow:messageflow@localhost:5432/messageflow

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit a real secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phone validation ---
# Default region used when a number has no international prefix.
DEFAULT_REGION=IN

# --- Uploads ---
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_IMPORT=10/minute

# --- App ---
APP_NAME=MessageFlow
APP_ENV=development
DEBUG=false
